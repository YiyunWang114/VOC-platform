generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 产品管理
model Product {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  category    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  feedbacks   Feedback[]
}

model UploadBatch {
  id             String   @id @default(uuid())
  fileName       String
  totalCount     Int
  processedCount Int      @default(0)
  status         String   @default("processing")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 竞品品牌配置
model CompetitorBrand {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  color       String   @default("#6366f1")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// 数据接入源配置
model DataSource {
  id          String   @id @default(uuid())
  name        String
  type        String
  config      String   @default("{}")
  isActive    Boolean  @default(true)
  lastFetchAt DateTime?
  createdAt   DateTime @default(now())
}

// 竞品动态告警规则
model CompetitorAlert {
  id          String   @id @default(uuid())
  name        String
  brandCode   String
  condition   String
  threshold   Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// 竞品动态事件
model CompetitorEvent {
  id          String   @id @default(uuid())
  brandCode   String
  alertId     String?
  eventType   String
  severity    String
  title       String
  description String
  data        String   @default("{}")
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ========== 用户与权限系统 ==========

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String   // bcrypt哈希
  name        String
  email       String?  @unique
  role        String   @default("customerService") // admin, productManager, dataAnalyst, operator, customerService
  status      String   @default("active") // active, inactive, suspended
  lastLoginAt DateTime?
  loginCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ticketsCreated Ticket[] @relation("TicketCreator")
  feedbacksHandled Feedback[] @relation("FeedbackHandler")
  auditLogs   AuditLog[]
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // login, logout, create, update, delete, export
  resource   String   // feedback, ticket, product, report等
  resourceId String?
  details    String?  @default("{}")
  ip         String?
  createdAt  DateTime @default(now())
}

// ========== 现有模型扩展 ==========

model Ticket {
  id          String   @id @default(uuid())
  title       String
  description String
  priority    String
  status      String   @default("todo")
  feedbackId  String
  feedback    Feedback @relation(fields: [feedbackId], references: [id])
  createdById String?
  createdBy   User?    @relation("TicketCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Feedback {
  id          String   @id @default(uuid())
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  productCode String?
  rawContent  String
  sentiment   String
  category    String
  coreIssue   String
  userDemand  String
  urgency     String
  source      String
  channel     String
  status      String   @default("pending")

  brand       String   @default("own")
  brandName   String   @default("本品")
  platform    String   @default("未知")
  externalId  String?
  rating      Int?
  metadata    String?  @default("{}")
  dataSource  String   @default("upload")
  importBatch String?

  churnRisk     Int      @default(0)
  smartReply    String?

  analysisSource String   @default("mock")

  handledById String?
  handledBy   User?    @relation("FeedbackHandler", fields: [handledById], references: [id])
  handledAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets     Ticket[]
}
