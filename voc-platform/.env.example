# 数据库连接（生产环境推荐 Neon Postgres；本地 SQLite 开发请用 file:./dev.db）
# DATABASE_URL = 连接池地址（Prisma Client 运行时使用，末尾带 pgbouncer=true）
# DIRECT_URL   = 直连地址（prisma migrate 等 CLI 操作使用）
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# JWT 登录签名密钥（生产环境必填，请用随机长字符串；本地开发可留空，会自动生成临时密钥）
JWT_SECRET=""

# DeepSeek 大模型 API Key（AI 语义打标 / 聚类 / 洞察链路使用）
DEEPSEEK_API_KEY=""

# 是否启用 AI mock 模式（true=使用本地规则引擎，不调用外部模型，便于无 Key 演示）
AI_MOCK=false